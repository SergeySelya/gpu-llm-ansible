# {{ ansible_managed }}
groups:
  - name: llm-gpu
    rules:
      - alert: LLMApiDown
        expr: up{job="vllm"} == 0
        for: 2m
        labels: {severity: critical}
        annotations:
          summary: "vLLM на {{ '{{' }} $labels.host {{ '}}' }} не отвечает 2 минуты"

      - alert: GPUExporterDown
        expr: up{job="dcgm"} == 0
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "Нет метрик GPU с {{ '{{' }} $labels.host {{ '}}' }}"

      - alert: GPUXidErrors
        expr: DCGM_FI_DEV_XID_ERRORS > 0
        labels: {severity: critical}
        annotations:
          summary: "XID {{ '{{' }} $value {{ '}}' }} на GPU {{ '{{' }} $labels.gpu {{ '}}' }}: аппаратная или драйверная ошибка"

      - alert: GPUOverheat
        expr: DCGM_FI_DEV_GPU_TEMP > {{ monitoring_alert_gpu_temp_c }}
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "GPU {{ '{{' }} $labels.gpu {{ '}}' }} {{ '{{' }} $value {{ '}}' }}°C дольше 5 минут"

      - alert: LLMQueueGrowing
        expr: sum(vllm:num_requests_waiting) > 0
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "Запросы ждут в очереди vLLM 5 минут: не хватает мощности"

      - alert: LLMKVCacheFull
        expr: max(vllm:kv_cache_usage_perc) > {{ monitoring_alert_kv_cache_ratio }}
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "KV-кэш vLLM заполнен на {{ '{{' }} $value | humanizePercentage {{ '}}' }}: запросы вытесняются"
