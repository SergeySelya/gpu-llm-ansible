# {{ ansible_managed }}
name: {{ llm_project_name }}

services:
  vllm:
    image: {{ llm_vllm_image }}
    restart: unless-stopped
    env_file: .env
    command:
      - {{ llm_model | to_json }}
      - --served-model-name={{ llm_served_model_name }}
      - --host=0.0.0.0
      - --port=8000
      - --max-model-len={{ llm_max_model_len }}
      - --gpu-memory-utilization={{ llm_gpu_memory_utilization }}
      - --tensor-parallel-size={{ llm_tensor_parallel_size }}
{% for arg in llm_extra_args %}
      - {{ arg | to_json }}
{% endfor %}
    # vLLM использует shared memory между процессами; без ipc=host падает на /dev/shm 64M
    ipc: host
    volumes:
      - {{ llm_base_dir }}/hf-cache:/root/.cache/huggingface
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
{% if llm_gpu_devices == 'all' %}
              count: all
{% else %}
              device_ids: {{ llm_gpu_devices | to_json }}
{% endif %}
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)"]
      interval: 15s
      timeout: 10s
      retries: 3
      start_period: 30m
    networks: [llm]

  nginx:
    image: {{ llm_nginx_image }}
    restart: unless-stopped
    depends_on:
      vllm:
        condition: service_started
    ports:
      - "{{ llm_listen_address }}:{{ llm_https_port }}:443"
    volumes:
      - {{ llm_base_dir }}/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ llm_base_dir }}/certs:/etc/nginx/certs:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/nginx-health"]
      interval: 30s
      timeout: 5s
      retries: 3
    networks: [llm]
{% if llm_monitoring_enabled | bool %}

  dcgm-exporter:
    image: {{ llm_dcgm_exporter_image }}
    restart: unless-stopped
    cap_add: [SYS_ADMIN]
    ports:
      - "{{ llm_dcgm_exporter_listen_address }}:{{ llm_dcgm_exporter_port }}:9400"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    networks: [llm]
{% endif %}

networks:
  llm:
    ipam:
      config:
        - subnet: {{ llm_docker_subnet }}
          gateway: {{ llm_docker_gateway }}
