# {{ ansible_managed }}
worker_processes auto;
worker_rlimit_nofile 65535;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 4096;
}

http {
    server_tokens off;
    log_format main '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                    'rt=$request_time urt=$upstream_response_time "$http_user_agent"';
    access_log /dev/stdout main;

    limit_req_zone $binary_remote_addr zone=llm_api:10m rate={{ llm_rate_limit }};
    limit_req_status 429;

    # Docker DNS: перерезолвим vllm после пересоздания контейнера
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 127.0.0.1:8080;
        location = /nginx-health {
            access_log off;
            return 200 "ok\n";
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name {{ llm_server_name }};

        ssl_certificate     /etc/nginx/certs/tls.crt;
        ssl_certificate_key /etc/nginx/certs/tls.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_cache   shared:SSL:10m;

        client_max_body_size {{ llm_client_max_body_size }};

        set $vllm http://vllm:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        location = /health {
            access_log off;
            proxy_pass $vllm;
        }

        location /v1/ {
            allow 127.0.0.1;
            allow {{ llm_docker_gateway }};
{% for cidr in llm_allowed_cidrs %}
            allow {{ cidr }};
{% endfor %}
            deny all;

            limit_req zone=llm_api burst={{ llm_rate_limit_burst }} nodelay;

            # SSE-стриминг токенов (stream=true) без буферизации
            proxy_buffering off;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
            proxy_pass $vllm;
        }

        location = /metrics {
            allow 127.0.0.1;
            allow {{ llm_docker_gateway }};
{% for cidr in llm_metrics_allowed_cidrs %}
            allow {{ cidr }};
{% endfor %}
            deny all;
            proxy_pass $vllm;
        }

        location / {
            return 404;
        }
    }
}
